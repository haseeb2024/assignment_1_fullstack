<div class="card details-panel">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">School details</h2>
        <button type="button" class="btn-close" aria-label="Close" @onclick="HandleClose"></button>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">School ID</dt>
            <dd class="col-sm-8">@School.SchoolId</dd>

            <dt class="col-sm-4">School name</dt>
            <dd class="col-sm-8">@School.SchoolName</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@School.Address</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@School.PhoneNo</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8"><a href="mailto:@School.EmailAddress">@School.EmailAddress</a></dd>

            <dt class="col-sm-4">Proprietor</dt>
            <dd class="col-sm-8">@School.ProprietorFullName</dd>

            <dt class="col-sm-4">Head</dt>
            <dd class="col-sm-8">@School.HeadFullName</dd>
        </dl>
    </div>
</div>

@code {
    [Parameter]
    public School School { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    private Task HandleClose() => OnClose.InvokeAsync();
}
